{
  "expo": {
    "name": "Inventariaje",
    "slug": "inventariaje-app",
    "version": "2.4.0",
    "orientation": "portrait",
    "icon": "./assets/newlogo.png",
    "splash": {
      "image": "./assets/newlogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#24c5c5"
    },
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.fherpecero.inventariajeapp",
      "versionCode": 8,
      "icon": "./assets/newlogo.png"
    },
    "extra": {
      "eas": {
        "projectId": "62aaf181-4537-4cb6-bf95-530933accc6d"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-sharing",
      "expo-splash-screen",
      [
      "expo-build-properties",
      {
          "android": {
            "enableProguardInReleaseBuilds": true
          }
      }
    ]
    ],
    "owner": "fherpecero",
    "ios": {
      "bundleIdentifier": "com.fherpecero.inventariajeapp"
    }
  }
}
