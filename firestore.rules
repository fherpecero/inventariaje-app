rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ✅ CUENTAS: Lectura pública para obtener ID consecutivo
    match /cuentas/{cuentaId} {
      // Cualquier usuario autenticado puede LEER cuentas (para generar IDs)
      allow read: if request.auth != null;
      
      // Solo el propietario o miembros pueden ESCRIBIR
      allow write: if request.auth.uid in resource.data.miembros;
      
      // Crear nueva cuenta: cualquier usuario autenticado
      allow create: if request.auth.uid != null;
      
      // Subcollecciones de inventarios
      match /inventarios/{inventarioId} {
        allow read: if request.auth.uid in get(/databases/$(database)/documents/cuentas/$(cuentaId)).data.miembros;
        allow write: if request.auth.uid in get(/databases/$(database)/documents/cuentas/$(cuentaId)).data.miembros;
        allow create: if request.auth.uid != null;
        
        // Items dentro de inventarios
        match /items/{itemId} {
          allow read: if request.auth.uid in get(/databases/$(database)/documents/cuentas/$(cuentaId)).data.miembros;
          allow write: if request.auth.uid in get(/databases/$(database)/documents/cuentas/$(cuentaId)).data.miembros;
          allow create: if request.auth.uid != null;
        }
      }
    }
    
    // ✅ USUARIOS: Cada usuario solo ve su documento
    match /usuarios/{userId} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId;
      allow create: if request.auth.uid != null;
    }
    
    // ✅ USUARIOS CUENTA: Cada usuario solo ve su índice
    match /usuariosCuenta/{userId} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId;
      allow create: if request.auth.uid != null;
    }
    
    // ✅ CATÁLOGO GLOBAL: Todos pueden leer, solo admins escriben
    match /catalogoGlobal/{productoId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    
    // ✅ ENTRADAS: Lectura/escritura por cuenta
    match /entradas/{entradaId} {
      allow read: if request.auth.uid in get(/databases/$(database)/documents/cuentas/$(resource.data.cuentaId)).data.miembros;
      allow write: if request.auth.uid in get(/databases/$(database)/documents/cuentas/$(resource.data.cuentaId)).data.miembros;
      allow create: if request.auth.uid != null;
    }
    
    // ✅ SALIDAS: Lectura/escritura por cuenta
    match /salidas/{salidaId} {
      allow read: if request.auth.uid in get(/databases/$(database)/documents/cuentas/$(resource.data.cuentaId)).data.miembros;
      allow write: if request.auth.uid in get(/databases/$(database)/documents/cuentas/$(resource.data.cuentaId)).data.miembros;
      allow create: if request.auth.uid != null;
    }
  }
}